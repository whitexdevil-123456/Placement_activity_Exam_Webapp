# Backend only. Never expose SUPABASE_SERVICE_ROLE_KEY to the browser.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_SERVER_SIDE_KEY
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_USERNAME=teacher
ADMIN_PASSWORD_HASH=PASTE_A_WERKZEUG_PASSWORD_HASH_HERE
ADMIN_MFA_EMAIL=admin@your-domain.com
FRONTEND_ORIGIN=http://localhost:3000,https://YOUR-FRONTEND.vercel.app

# Optional: enable AI-assisted programming grading. API usage may incur separate charges.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Student password recovery email (Resend; keep key server-side only)
RESEND_API_KEY=
PASSWORD_RESET_FROM=Class Test Portal <no-reply@your-verified-domain.example>
TWO_FACTOR_FROM=Class Test Portal <no-reply@your-verified-domain.example>
FRONTEND_BASE_URL=http://localhost:3000
